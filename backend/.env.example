#
# 테스트할 경우 .env로 파일 생성 후, 밑의 내용을 복사 붙여넣기 하고
# your_openai_api_key_here 부분을 실제 OpenAI API 키로 바꾸시면 됩니다.
# 키는 https://platform.openai.com/account/api-keys 에서 확인할 수 있습니다.
# .env 파일은 git에 업로드되지 않게 .gitignore에 추가되어 있으니 유출되지 않습니다.

OPENAI_API_KEY=your_openai_api_key_here
APP_AI_PROVIDER=openai
APP_AI_MODEL=gpt-4o-mini
APP_AI_TEMPERATURE=0.2
APP_AI_MAX_TOKENS=800
